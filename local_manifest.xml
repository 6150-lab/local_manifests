<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- 6150-lab -->
  <remote
      name="6150-lab"
      fetch="https://github.com/6150-lab/" />

  <!-- stahed-sweet-lab -->
  <remote
      name="stahed-sweet-lab"
      fetch="https://github.com/stahed-sweet-lab/" />

  <!-- Other sources -->
  <remote
      name="gh"
      fetch="https://github.com/" />

  <!-- Device trees -->
  <project
      path="device/xiaomi/sweet"
      name="device_xiaomi_sweet"
      remote="6150-lab"
      revision="alpha-16.2" />

  <project
      path="device/xiaomi/sm6150-common"
      name="device_xiaomi_sm6150-common"
      remote="6150-lab"
      revision="alpha-16.2" />

  <!-- Vendor blobs -->
  <project
      path="vendor/xiaomi/sweet"
      name="vendor_xiaomi_sweet"
      remote="6150-lab"
      revision="alpha-16.2" />

  <project
      path="vendor/xiaomi/sm6150-common"
      name="vendor_xiaomi_sm6150-common"
      remote="6150-lab"
      revision="alpha-16.2" />

  <project
      path="vendor/miuicamera-sweet"
      name="vendor_miuicamera-sweet"
      remote="6150-lab"
      revision="alpha-16.2" />

  <!-- Kernel -->
  <project
      path="kernel/xiaomi/sm6150"
      name="kernel_xiaomi_sm6150"
      remote="6150-lab"
      revision="vantom-ksun" />

  <!-- Hardware -->
  <project
      path="hardware/xiaomi"
      name="hardware_xiaomi"
      remote="6150-lab"
      revision="alpha-16.2" />

  <!-- Packages apps -->
  <project
      path="packages/apps/GameBar"
      name="packages_apps_GameBar"
      remote="6150-lab"
      revision="alpha-16.2" />

  <!-- XiaomiDolby -->
  <project
        path="packages/apps/XiaomiDolby"
        name="packages_apps_XiaomiDolby"
        remote="stahed-sweet-lab"
        revision="16.2" />

  <project
      path="vendor/sony/dolby"
      name="vendor_sony_dolby"
      remote="6150-lab"
      revision="alpha-16.2" />

  <!-- ViPERFX -->
  <project
      path="packages/apps/ViPER4AndroidFX"
      name="packages_apps_ViPER4AndroidFX"
      remote="6150-lab"
      revision="17" />

  <!-- Interfaces -->
  <project
      name="AlphaDroid-Project/hardware_pixelworks_interfaces"
      path="hardware/pixelworks/interfaces"
      revision="alpha-16.2" />
</manifest>
